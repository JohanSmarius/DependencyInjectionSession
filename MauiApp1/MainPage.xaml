<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:DIExplanation;assembly=SharedLibrary"
             x:Class="MauiApp1.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">


            <CollectionView ItemsSource="{Binding LineItems}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:OrderLine">
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="15" Padding="0,5">
                            <Label Grid.Column="0" Text="{Binding Product}" FontAttributes="Bold" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{Binding Quantity, StringFormat='Qty: {0}'}" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="{Binding Price, StringFormat='{0:C}'}" VerticalOptions="Center" />
                            <Label Grid.Column="3" Text="{Binding LinePrice, StringFormat='Total: {0:C}'}" VerticalOptions="Center" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
